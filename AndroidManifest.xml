<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.topicsmap.proximitynotes">

    <!-- ============================================================= -->
    <!-- BLUETOOTH & BLE SCANNING PERMISSIONS (Android 12+ API 31+)    -->
    <!-- ============================================================= -->
    <!-- Required to discover and scan for nearby BLE devices/beacons  -->
    <uses-permission 
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    
    <!-- Required to connect or read GATT characteristics if needed     -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    
    <!-- Legacy Bluetooth permissions for Android 11 (API 30) & lower   -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!-- ============================================================= -->
    <!-- LOCATION PERMISSION (Required by OS for legacy BLE beacon RSSI)-->
    <!-- ============================================================= -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- ============================================================= -->
    <!-- NOTIFICATIONS & SOUND PERMISSIONS (Android 13+ API 33+)       -->
    <!-- ============================================================= -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ============================================================= -->
    <!-- FOREGROUND SERVICE (Android 14+ API 34+ Requirements)         -->
    <!-- Mandatory for continuous proximity scanning without OS kill   -->
    <!-- Type: 'connectedDevice' is the approved Google Play category -->
    <!-- ============================================================= -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- BLE Hardware feature requirement declaration -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <application
        android:label="TopicsMap"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@style/LaunchTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- ========================================================== -->
        <!-- Foreground Service Registration for Continuous BLE Proximity-->
        <!-- ========================================================== -->
        <service 
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="connectedDevice"
            android:stopWithTask="false"
            android:exported="false" />

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>